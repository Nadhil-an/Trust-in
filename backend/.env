# ── Django Core ──────────────────────────────────────────────────
SECRET_KEY=sree-lakshmi-trust-dev-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.252.22.21,172.18.166.21,10.252.22.21:8000,172.18.166.21:8000

# ── Database (SQLite for dev, switch to PostgreSQL in prod) ───────
DATABASE_URL=sqlite:///db.sqlite3
# Production PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/sreelakshmi_db

# ── Redis (in-memory fallback if Redis not running) ───────────────
REDIS_URL=redis://127.0.0.1:6379/0
USE_REDIS=False

# ── JWT ───────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=1440
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://10.252.22.21:8081,http://172.18.166.21:8081,http://172.18.166.21:19000,http://172.18.166.21:19006

# ── File Uploads ──────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ── AWS (for deployment) ──────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-south-1

# ── WhatsApp Gateway (100% FREE Self-Hosted Gateway) ──────────────
WHATSAPP_ENABLED=True
WHATSAPP_GATEWAY_URL=http://localhost:3001/send-message
WHATSAPP_GATEWAY_TOKEN=sree_trust_secret_12345


