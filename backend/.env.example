# ═══════════════════════════════════════════════════════════════════════
#  .env.example — Sree Lakshmi Trust Backend
#  Copy this file to .env and fill in the real values.
#  NEVER put real secrets in this file. This file IS committed to git.
# ═══════════════════════════════════════════════════════════════════════

# ── Django Core ──────────────────────────────────────────────────────
# Generate a new key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-very-long-random-secret-key-here

# Set to False for production ALWAYS
DEBUG=False

# Comma-separated list of allowed hostnames (no http://, no port)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Field-Level Encryption ────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CRITICAL: Losing this key means all encrypted data becomes unreadable. Back it up securely!
FIELD_ENCRYPTION_KEY=your-fernet-key-here

# ── Database ─────────────────────────────────────────────────────────
# For development (SQLite):
# DATABASE_URL=sqlite:///db.sqlite3
# For production (AWS RDS PostgreSQL):
DATABASE_URL=postgres://DB_USER:DB_PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/sreelakshmi_trust

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
USE_REDIS=True

# ── JWT ───────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (with https://)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── File Uploads ──────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ── Cloudflare R2 Storage ─────────────────────────────────────────────
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=sree-trust-media
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.yourdomain.com

# ── WhatsApp Gateway ──────────────────────────────────────────────────
WHATSAPP_ENABLED=True
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:3001/send-message
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WHATSAPP_GATEWAY_TOKEN=your-strong-random-token-here
