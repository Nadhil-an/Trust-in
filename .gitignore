# ═══════════════════════════════════════════════════════════════════════
#  ROOT .gitignore — Sree Lakshmi Trust
#  This file ensures NO secrets, credentials, or build artifacts
#  are ever committed to version control.
# ═══════════════════════════════════════════════════════════════════════

# ── Environment / Secret Files (NEVER COMMIT) ──────────────────────────
.env
.env.*
!.env.example
*.env

# ── Python Backend ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so
db.sqlite3
*.sqlite3
backend/logs/
backend/media/
backend/staticfiles/
backend/.cache/

# ── Node / WhatsApp Gateway ────────────────────────────────────────────
node_modules/
backend/whatsapp_gateway/node_modules/
backend/whatsapp_gateway/auth_info_baileys/

# ── Frontend Build ─────────────────────────────────────────────────────
frontend/dist/
frontend/dist-ssr/
*.local

# ── Docker ────────────────────────────────────────────────────────────
docker-data/

# ── Editors & OS ──────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
